{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window, including sidecar spawn permission for the SvelteKit adapter-node server.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/usc-server",
          "sidecar": true
        }
      ]
    }
  ]
}
