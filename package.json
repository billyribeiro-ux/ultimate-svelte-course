{
	"name": "ultimate-svelte-course",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo '' && lefthook install || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"dev:tauri": "cross-env TAURI_BUILD=1 tauri dev",
		"build:tauri:frontend": "cross-env TAURI_BUILD=1 vite build && node scripts/package-sidecar.mjs",
		"build:tauri": "cross-env TAURI_BUILD=1 tauri build",
		"build:tauri:universal": "cross-env TAURI_BUILD=1 tauri build --target universal-apple-darwin",
		"e2e": "playwright test",
		"e2e:ui": "playwright test --ui",
		"e2e:debug": "playwright test --debug",
		"e2e:report": "playwright show-report",
		"e2e:codegen": "playwright codegen http://localhost:4173"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.11.1",
		"@commitlint/cli": "^19.6.0",
		"@commitlint/config-conventional": "^19.6.0",
		"@eslint/js": "^10.0.1",
		"@iconify-json/carbon": "^1.2.20",
		"@iconify-json/ph": "^1.2.2",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.68.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.1",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"cross-env": "^10.1.0",
		"eslint": "^10.2.0",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"jsdom": "^29.0.1",
		"lefthook": "^1.8.0",
		"mdsvex": "^0.12.7",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"svelte": "^5.56.4",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.0",
		"vite": "^7.3.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@iconify/svelte": "^5.2.1",
		"@tanstack/svelte-table": "^8.21.3",
		"gsap": "^3.14.2",
		"valibot": "^1.3.1"
	}
}
